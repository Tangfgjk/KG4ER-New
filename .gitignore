# Data and generated artifacts are intentionally excluded.
data/
runs/
ablation_data/
semantic_features/

# Model checkpoints and exported embeddings.
*.pt
*.pth
*.ckpt
*.npy
*.pkl

# V-Fin versions the reproducible raw data and inference-time text/MIRT
# arrays. Keep training checkpoints excluded, but retain .npy arrays under
# Data_Fin so a freshly cloned repository can run ER experiments directly.
!Data_Fin/
!Data_Fin/**/*.npy

# Python caches and local environments.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Logs and temporary outputs.
*.log
tmp/
temp/

# IDE and OS metadata.
.idea/
.vscode/
.DS_Store
Thumbs.db
